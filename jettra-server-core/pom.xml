<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.jettra</groupId>
        <artifactId>JettraServer</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jettra-server-core</artifactId>
    <packaging>jar</packaging>
    <name>jettra-server-core</name>
    <description>Núcleo del Servidor JettraServer: NIO Asíncrono con Loom Virtual Threads, SPI de almacenamiento de tres modos (JVM_RAM, DISK_MEMORY, OFF_HEAP), configuración, métricas y seguridad</description>

    <dependencies>
        <!-- Ecosistema Jettra -->
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraCollections</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraJSON</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraJWT</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraRules</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraCDI</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraReport</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraRest</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraAnnotation</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Motores de almacenamiento -->
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraMemory</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraStore-OffHeap</artifactId>
        </dependency>

        <!-- Testing con JettraTest (100% libre de JUnit) -->
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraTest</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>jettra-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>io.jettra.test.runner.JettraTestRunner</mainClass>
                            <classpathScope>test</classpathScope>
                            <cleanupDaemonThreads>false</cleanupDaemonThreads>
                            <arguments>
                                <argument>${project.build.testOutputDirectory}</argument>
                                <argument>${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

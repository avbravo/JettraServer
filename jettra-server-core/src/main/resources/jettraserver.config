# ==============================================================================
# JettraServer - Archivo de Configuración Oficial (jettraserver.config)
# Servidor Modular de Alto Rendimiento para Java 25 & Project Loom
# ==============================================================================

# Dirección IP y puerto de escucha del servidor HTTP NIO
server.host=0.0.0.0
server.port=8080

# Ruta base de contexto (Context Path) de la aplicación
contextpath=/
server.contextpath=/
server.path=/

# Modo de almacenamiento operativo del motor de persistencia JettraServer:
#   JVM_RAM     -> Modo memoria RAM estándar de la JVM (UnifiedMap, Heap & Stack).
#   DISK_MEMORY -> Motor de disco directo Off-Heap LSM (JettraMemory).
#   OFF_HEAP    -> Motor de páginas ranuradas nativas Slotted-Page (Panama FFM).
storage.mode=JVM_RAM

# Directorio base para datos persistentes (empleado por DISK_MEMORY y OFF_HEAP)
data.dir=./data/jettra-server

# Tamaño de página para el motor de almacenamiento OFF_HEAP (bytes, por defecto 64KB = 65536)
storage.offheap.page-size=65536

# Habilitar políticas de intercambio de recursos de origen cruzado (CORS)
cors.enabled=true

# Activar concurrencia impulsada por hilos virtuales de Java 25 (Project Loom)
server.virtual-threads=true

# Clave secreta y expiración para tokens JWT (Jakarta Security)
jwt.secret=jettra_server_super_secure_jwt_key_2026
jwt.expiration-millis=86400000

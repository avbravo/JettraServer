# ==============================================================================
# JETTRASERVER BACKEND MICROSERVICES CONFIGURATION (Java 25+ & Loom)
# ==============================================================================

# Servidor y Enlace de Red
server.host=0.0.0.0
server.port=8083
server.backlog=2048
contextpath=/

# Hilos Virtuales de Project Loom
server.virtual-threads=true

# Modo de Persistencia Tri-Modal (JVM_RAM, DISK_MEMORY, OFF_HEAP)
storage.mode=JVM_RAM
data.dir=./data/jettra-backend

# Base de Datos de Seguridad Embebida
security.db.path=./data/jettra-backend/securitydb

# Seguridad de Tokens JWT
server.jwt.secret=jettra_backend_super_secret_jwt_key_2026
server.jwt.expiration=86400000

# CORS
cors.enabled=true

